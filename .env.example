# Required for production admin. Use the exact, canonical HTTPS origin.
SHIRO_PUBLIC_ORIGIN=https://www.omya.games
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Separate production and preview databases or namespaces.
SHIRO_AUTH_NAMESPACE=shiro:production:auth
# For a self-hosted reverse proxy only: its exact IP/CIDR or loopback.
# Leave unset on Vercel; the platform is detected automatically.
# SHIRO_TRUST_PROXY=loopback

# Server-only fine-grained token: Contents read/write on this repository only.
SHIRO_GITHUB_REPOSITORY=belmead/hugo-blog
SHIRO_GITHUB_BRANCH=shiro
SHIRO_GITHUB_TOKEN=
